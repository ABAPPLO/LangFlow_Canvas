COMPOSE_PROJECT_NAME=langflow-test
APP_IMAGE=langflowai/langflow:latest
# Only required when LANGFLOW_CELERY_ENABLED=True and APP_IMAGE also contains celery.
WORKER_IMAGE=langflowai/langflow:latest
DOCKER_NETWORK_NAME=langflow-test-net
TZ=Asia/Shanghai

MASTER_PORT=7860
SLAVE1_PORT=7861

POSTGRES_HOST=langflow-postgres
# App containers connect through the Docker network, so use the PostgreSQL container port.
POSTGRES_PORT=5432
POSTGRES_USER=langflow
POSTGRES_PASSWORD=LangFlow2024!Secure
POSTGRES_DB=langflow

REDIS_HOST=langflow-redis
REDIS_PORT=6379

APP_DATA_DIR=/www/dk_project/dk_compose/langflow-canvas/app-data

LANGFLOW_AUTO_LOGIN=False
LANGFLOW_SUPERUSER=admin@xiaoti.com
LANGFLOW_SUPERUSER_PASSWORD=LangFlow2024!Secure
LANGFLOW_SECRET_KEY=aH7kL9mP2qR5tV8wX1zC4eF6gI0jK3nO
LANGFLOW_LOG_LEVEL=info
LANGFLOW_OPEN_BROWSER=False
LANGFLOW_CELERY_ENABLED=False
